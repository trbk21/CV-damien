---
import { cvData } from '../data/cv';
import { Mail, Globe, MapPin, Printer, ArrowLeft } from '@lucide/astro';

const { 
    name, 
    title, 
    email, 
    location, 
    websites, 
    softwareGroups, 
    softSkills, 
    experiences,
    certification,
    philosophies
} = cvData;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{name} | Full CV</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;700;900&display=swap" rel="stylesheet">
        <style>
            :root {
                --cv-width: 1000px;
                --sidebar-bg: #f8fafc;
                --text-main: #0f172a;
                --text-muted: #475569;
                --border-color: #e2e8f0;
            }

            body {
                margin: 0;
                padding: 0;
                background-color: #f1f5f9;
                font-family: 'Inter', sans-serif;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
            }

            .no-print-header {
                position: sticky;
                top: 0;
                z-index: 50;
                background: rgba(15, 23, 42, 0.9);
                backdrop-filter: blur(8px);
                padding: 1rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: white;
                box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            }

            .btn {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.5rem 1rem;
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                transition: all 0.2s;
                cursor: pointer;
                border: 1px solid rgba(255,255,255,0.2);
                text-decoration: none;
                color: white;
            }

            .btn:hover {
                background: white;
                color: black;
            }

            .cv-container {
                width: var(--cv-width);
                max-width: 100%;
                margin: 0 auto;
                background: white;
                box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: 320px;
                background-color: var(--sidebar-bg);
                padding: 40px;
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                gap: 30px;
            }

            .main-content {
                flex: 1;
                padding: 40px 50px;
                display: flex;
                flex-direction: column;
                gap: 40px;
            }

            .profile-img-container {
                width: 240px;
                height: 240px;
                border: 1px solid var(--border-color);
                overflow: hidden;
                filter: grayscale(1);
                margin-bottom: 20px;
            }

            .profile-img-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            h1 {
                font-size: 32pt;
                font-weight: 900;
                line-height: 1.1;
                margin: 0;
                letter-spacing: -0.05em;
                text-transform: uppercase;
            }

            .subtitle {
                font-size: 11pt;
                font-weight: 300;
                text-transform: uppercase;
                letter-spacing: 0.3em;
                color: var(--text-muted);
                margin-top: 10px;
            }

            h2 {
                font-size: 10pt;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.4em;
                color: var(--text-muted);
                border-bottom: 2px solid var(--text-main);
                padding-bottom: 8px;
                margin-bottom: 15px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            h3 {
                font-size: 14pt;
                font-weight: 700;
                margin: 0;
                letter-spacing: -0.02em;
            }

            .contact-item {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 9pt;
                font-weight: 500;
                color: var(--text-muted);
            }

            .skill-tag {
                font-size: 8pt;
                font-weight: 600;
                padding: 4px 8px;
                border: 1px solid var(--border-color);
                background: white;
                white-space: nowrap;
            }

            .exp-item {
                position: relative;
                padding-left: 25px;
                border-left: 1px solid var(--border-color);
            }

            .exp-dot {
                position: absolute;
                left: -6px;
                top: 8px;
                width: 11px;
                height: 11px;
                background: white;
                border: 2px solid var(--text-main);
            }

            .exp-meta {
                font-size: 9pt;
                font-weight: 700;
                color: #64748b;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                margin-bottom: 5px;
            }

            .exp-company {
                font-size: 10pt;
                font-weight: 600;
                font-style: italic;
                color: #475569;
                margin-bottom: 12px;
            }

            .exp-desc {
                font-size: 10pt;
                line-height: 1.6;
                color: #334155;
            }

            .exp-desc p { margin-bottom: 10px; }

            .exp-skills {
                display: flex;
                flex-wrap: wrap;
                gap: 6px;
                margin-top: 15px;
            }

            .exp-skill {
                font-size: 8pt;
                font-weight: 800;
                text-transform: uppercase;
                padding: 2px 6px;
                border: 1px solid #cbd5e1;
                color: #64748b;
            }

            @media print {
                body {
                    background: white;
                }
                .no-print-header {
                    display: none !important;
                }
                .cv-container {
                    margin: 0;
                    box-shadow: none;
                    width: 100%;
                }
                /* Allow long page printing */
                .cv-container {
                    display: block;
                }
                .sidebar {
                    width: 100%;
                    border-right: none;
                    border-bottom: 1px solid var(--border-color);
                }
                /* Ensure no awkward breaks */
                .exp-item {
                    page-break-inside: avoid;
                }
            }
        </style>
    </head>
    <body>
        <header class="no-print-header">
            <a href="/" class="btn">
                <ArrowLeft size={16} />
                Retour
            </a>
            <div style="font-size: 0.8rem; font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase;">Full CV - Version Longue</div>
            <button onclick="window.print()" class="btn">
                <Printer size={16} />
                Exporter en PDF
            </button>
        </header>

        <div class="cv-container" id="cv-root">
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="profile-img-container">
                    <img src="/Damien-miri.webp" alt={name} />
                </div>

                <div class="space-y-4">
                    <div class="contact-item">
                        <Mail size={14} />
                        {email}
                    </div>
                    <div class="contact-item">
                        <MapPin size={14} />
                        {location}
                    </div>
                    {websites.map(site => (
                        <div class="contact-item">
                            <Globe size={14} />
                            {site.name}
                        </div>
                    ))}
                </div>

                <section>
                    <h2>Outils & Expertise</h2>
                    <div style="display: flex; flex-direction: column; gap: 15px;">
                        {softwareGroups.map(group => (
                            <div>
                                <div style="font-size: 8pt; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 8px;">
                                    {group.category}
                                </div>
                                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                    {group.tools.map(tool => (
                                        <span class="skill-tag">{tool}</span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Certification</h2>
                    <div style="font-size: 9pt; font-weight: 800; text-transform: uppercase; margin-bottom: 4px;">{certification.title}</div>
                    <div style="font-size: 9pt; font-weight: 700; color: var(--text-main); margin-bottom: 4px;">{certification.role}</div>
                    <div style="font-size: 9pt; color: var(--text-muted); line-height: 1.5;">{certification.desc}</div>
                </section>

                <section>
                    <h2>Soft Skills</h2>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        {softSkills.map(skill => (
                            <span class="skill-tag" style="text-transform: uppercase; letter-spacing: 0.05em;">{skill}</span>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Philosophie</h2>
                    <div style="display: flex; flex-direction: column; gap: 15px;">
                        {philosophies.map(phi => (
                            <div>
                                <div style="font-size: 9pt; font-weight: 800; text-transform: uppercase; margin-bottom: 4px;">{phi.title}</div>
                                {phi.detail && <div style="font-size: 9pt; font-style: italic; color: var(--text-muted); margin-bottom: 2px;">{phi.detail}</div>}
                                <div style="font-size: 9pt; color: var(--text-muted); line-height: 1.5;">{phi.desc}</div>
                            </div>
                        ))}
                    </div>
                </section>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                <header>
                    <h1>{name}</h1>
                    <div class="subtitle">{title}</div>
                </header>

                <section>
                    <h2>Parcours Professionnel</h2>
                    <div style="display: flex; flex-direction: column; gap: 30px;">
                        {experiences.map(exp => (
                            <div class="exp-item">
                                <div class="exp-dot"></div>
                                <div class="exp-meta">{exp.period}</div>
                                <h3>{exp.title}</h3>
                                <div class="exp-company">{exp.company} — {exp.location}</div>
                                <div class="exp-desc">
                                    {exp.desc.split('\n\n').map(p => (
                                        <p>{p}</p>
                                    ))}
                                </div>
                                {exp.skills && (
                                    <div class="exp-skills">
                                        {exp.skills.map(skill => (
                                            <span class="exp-skill">{skill}</span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        ))}
                    </div>
                </section>
            </main>
        </div>
    </body>
</html>
