---
import { cvData } from '../data/cv';
import { Mail, Globe, MapPin, Printer, ArrowLeft, Calendar } from '@lucide/astro';

const { 
    name, 
    title, 
    tagline,
    email, 
    birthDate,
    location, 
    websites, 
    softwareGroups, 
    softSkills, 
    experiencesA4: experiences,
    certification,
    philosophies,
    teaching
} = cvData;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{name} | CV A4</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;700;900&display=swap" rel="stylesheet">
        <style>
            :root {
                --paper-width: 210mm;
                --paper-height: 295mm;
                --sidebar-bg: #f8fafc;
                --text-main: #0f172a;
                --text-muted: #475569;
                --border-color: #e2e8f0;
            }

            @page {
                size: A4;
                margin: 0;
            }

            body {
                margin: 0;
                padding: 0;
                background-color: white;
                font-family: 'Inter', sans-serif;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
            }

            .no-print-header {
                position: sticky;
                top: 0;
                z-index: 50;
                background: rgba(15, 23, 42, 0.9);
                backdrop-filter: blur(8px);
                padding: 1rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: white;
                box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            }

            .btn {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.5rem 1rem;
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                transition: all 0.2s;
                cursor: pointer;
                border: 1px solid rgba(255,255,255,0.2);
                text-decoration: none;
                color: white;
            }

            .btn:hover {
                background: white;
                color: black;
            }

            .a4-container {
                width: var(--paper-width);
                height: var(--paper-height);
                margin: 0 auto;
                background: white;
                display: flex;
                position: relative;
                overflow: hidden;
            }

            .sidebar {
                width: 60mm;
                background-color: var(--sidebar-bg);
                padding: 4mm 5mm 3mm 5mm;
                display: flex;
                flex-direction: column;
                gap: 2.5mm;
            }

            .main-content {
                flex: 1;
                padding: 4mm 10mm 3mm 10mm;
                display: flex;
                flex-direction: column;
                gap: 4mm;
            }

            h1 {
                font-size: 22pt;
                font-weight: 900;
                line-height: 1;
                margin: 0;
                letter-spacing: -0.05em;
                text-transform: uppercase;
            }

            .subtitle {
                font-size: 9pt;
                font-weight: 300;
                text-transform: uppercase;
                letter-spacing: 0.3em;
                color: var(--text-muted);
                margin-top: 1mm;
            }

            h2 {
                font-size: 8.5pt;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.4em;
                color: var(--text-main);
                border-bottom: 2px solid var(--text-main);
                padding-bottom: 0.5mm;
                margin-bottom: 1.5mm;
                display: flex;
                align-items: center;
                gap: 2mm;
            }

            h3 {
                font-size: 9.5pt;
                font-weight: 700;
                margin: 0;
                letter-spacing: -0.02em;
            }

            .contact-item {
                display: flex;
                align-items: center;
                gap: 2mm;
                font-size: 7.5pt;
                font-weight: 500;
                color: var(--text-muted);
            }

            .section-title-dot {
                width: 1.5mm;
                height: 1.5mm;
                background: var(--text-main);
            }

            .skill-tag {
                font-size: 6pt;
                font-weight: 600;
                padding: 0.5mm 1.2mm;
                border: 1px solid var(--border-color);
                background: white;
                white-space: nowrap;
            }

            .exp-item {
                position: relative;
                padding-left: 5mm;
                padding-bottom: 3.5mm;
                border-left: 1px solid var(--border-color);
            }

            .exp-item:last-child {
                padding-bottom: 0;
            }

            .exp-dot {
                position: absolute;
                left: -1.25mm;
                top: 1.5mm;
                width: 2.5mm;
                height: 2.5mm;
                background: white;
                border: 1px solid var(--text-main);
                border-radius: 50%;
            }

            .exp-meta {
                font-size: 7.5pt;
                font-weight: 700;
                color: #64748b;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                margin-bottom: 0.5mm;
            }

            .exp-company {
                font-size: 8pt;
                font-weight: 600;
                font-style: italic;
                color: #475569;
                margin-bottom: 0.4mm;
            }

            .exp-desc {
                font-size: 7.7pt;
                line-height: 1.26;
                color: #334155;
            }

            .exp-desc p {
                margin-top: 0;
                margin-bottom: 0.6mm;
            }
            .exp-desc p:last-child {
                margin-bottom: 0;
            }

            .exp-skills {
                display: flex;
                flex-wrap: wrap;
                gap: 1mm;
                margin-top: 1mm;
            }

            .exp-skill {
                font-size: 5.5pt;
                font-weight: 800;
                text-transform: uppercase;
                padding: 0.2mm 0.8mm;
                border: 1px solid #cbd5e1;
                color: #64748b;
            }

            @media print {
                .no-print-header {
                    display: none !important;
                }
                .a4-container {
                    margin: 0;
                    box-shadow: none;
                }
            }

            .profile-img-container {
                width: 42mm;
                height: 42mm;
                overflow: hidden;
                filter: grayscale(1);
                margin-bottom: 2mm;
                border-radius: 50%;
            }

            .profile-img-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        </style>
    </head>
    <body>
        <header class="no-print-header">
            <a href="/" class="btn">
                <ArrowLeft size={14} />
                Retour
            </a>
            <div style="font-size: 0.7rem; font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase;">A4 Preview</div>
            <button onclick="window.print()" class="btn">
                <Printer size={14} />
                Imprimer en PDF
            </button>
        </header>

        <div class="a4-container">
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="profile-img-container">
                    <img src="/Damien-miri.webp" alt={name} />
                </div>

                <div class="space-y-4">
                    {birthDate && (
                        <div class="contact-item">
                            <Calendar size={12} />
                            Né le {birthDate}
                        </div>
                    )}
                    <div class="contact-item">
                        <Mail size={12} />
                        {email}
                    </div>
                    <div class="contact-item">
                        <MapPin size={12} />
                        {location}
                    </div>
                    {websites.map(site => (
                        <div class="contact-item">
                            <Globe size={12} />
                            {site.name}
                        </div>
                    ))}
                </div>

                <section>
                    <h2>Outils & Expertise</h2>
                    <div style="display: flex; flex-direction: column; gap: 2mm;">
                        {softwareGroups.map(group => (
                            <div>
                                <div style="font-size: 7pt; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 1mm;">
                                    {group.category}
                                </div>
                                <div style="display: flex; flex-wrap: wrap; gap: 1mm;">
                                    {group.tools.map(tool => (
                                        <span class="skill-tag">{tool}</span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Certification</h2>
                    <div style="font-size: 7.5pt; font-weight: 800; text-transform: uppercase; margin-bottom: 0.5mm;">{certification.title}</div>
                    <div style="font-size: 7.5pt; font-weight: 700; color: var(--text-main); margin-bottom: 0.5mm;">{certification.role}</div>
                    <div style="font-size: 7.5pt; color: var(--text-muted); line-height: 1.25;">{certification.desc}</div>
                </section>
                


                <section>
                    <h2>Soft Skills</h2>
                    <div style="display: flex; flex-wrap: wrap; gap: 1mm;">
                        {softSkills.map(skill => (
                            <span class="skill-tag" style="text-transform: uppercase; letter-spacing: 0.05em;">{skill}</span>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Philosophie</h2>
                    <div style="display: flex; flex-direction: column; gap: 2mm;">
                        {philosophies.map(phi => (
                            <div>
                                <div style="font-size: 7.5pt; font-weight: 800; text-transform: uppercase; margin-bottom: 0.5mm;">{phi.title}</div>
                                {phi.detail && <div style="font-size: 7.5pt; font-style: italic; color: var(--text-muted); margin-bottom: 0.5mm;">{phi.detail}</div>}
                                <div style="font-size: 7.5pt; color: var(--text-muted); line-height: 1.25;">{phi.desc}</div>
                            </div>
                        ))}
                    </div>
                </section>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                <header>
                    <h1>{name}</h1>
                    {title && <div class="subtitle">{title}</div>}
                    {tagline && <div style="font-size: 7pt; color: #94a3b8; margin-top: 1.5mm; font-style: italic; letter-spacing: 0.05em; font-weight: 500;">{tagline}</div>}
                </header>

                <section>
                    <h2>Parcours Professionnel</h2>
                    <div style="display: flex; flex-direction: column;">
                        {experiences.map(exp => (
                            <div class="exp-item">
                                <div class="exp-dot"></div>
                                <div class="exp-meta">{exp.period}</div>
                                <h3>{exp.title}</h3>
                                <div class="exp-company">{exp.company} — {exp.location}</div>
                                <div class="exp-desc">
                                    {exp.desc.split('\n').map(p => (
                                        <p>{p}</p>
                                    ))}
                                </div>
                                {exp.skills && (
                                    <div class="exp-skills">
                                        {exp.skills.map(skill => (
                                            <span class="exp-skill">{skill}</span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Transmission & Pédagogie</h2>
                    <div style="display: flex; flex-direction: column;">
                        {teaching.map(item => (
                            <div class="exp-item">
                                <div class="exp-dot"></div>
                                <div class="exp-meta">{item.period}</div>
                                <h3>{item.title}</h3>
                                <div class="exp-company">{item.company}</div>
                                <div class="exp-desc">{item.desc}</div>
                            </div>
                        ))}
                    </div>
                </section>
            </main>
        </div>
    </body>
</html>
