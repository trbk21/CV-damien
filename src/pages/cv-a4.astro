---
import { cvData } from '../data/cv';
import { Mail, Globe, MapPin, Printer, ArrowLeft } from '@lucide/astro';

const { 
    name, 
    title, 
    tagline,
    email, 
    location, 
    websites, 
    softwareGroups, 
    softSkills, 
    experiences,
    certification,
    philosophies,
    teaching
} = cvData;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{name} | CV A4</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;700;900&display=swap" rel="stylesheet">
        <style>
            :root {
                --paper-width: 210mm;
                --paper-height: 297mm;
                --sidebar-bg: #f8fafc;
                --text-main: #0f172a;
                --text-muted: #475569;
                --border-color: #e2e8f0;
            }

            @page {
                size: A4;
                margin: 0;
            }

            body {
                margin: 0;
                padding: 0;
                background-color: #f1f5f9;
                font-family: 'Inter', sans-serif;
                color: var(--text-main);
                -webkit-font-smoothing: antialiased;
            }

            .no-print-header {
                position: sticky;
                top: 0;
                z-index: 50;
                background: rgba(15, 23, 42, 0.9);
                backdrop-filter: blur(8px);
                padding: 1rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: white;
                box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            }

            .btn {
                display: flex;
                items-center: center;
                gap: 0.5rem;
                padding: 0.5rem 1rem;
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                transition: all 0.2s;
                cursor: pointer;
                border: 1px solid rgba(255,255,255,0.2);
                text-decoration: none;
                color: white;
            }

            .btn:hover {
                background: white;
                color: black;
            }

            .a4-container {
                width: var(--paper-width);
                min-height: var(--paper-height);
                margin: 2rem auto;
                background: white;
                box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.15);
                display: flex;
                position: relative;
                overflow: hidden;
            }

            .sidebar {
                width: 75mm;
                background-color: var(--sidebar-bg);
                padding: 10mm;
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                gap: 8mm;
            }

            .main-content {
                flex: 1;
                padding: 10mm 12mm;
                display: flex;
                flex-direction: column;
                gap: 8mm;
            }

            h1 {
                font-size: 28pt;
                font-weight: 900;
                line-height: 1;
                margin: 0;
                letter-spacing: -0.05em;
                text-transform: uppercase;
            }

            .subtitle {
                font-size: 10pt;
                font-weight: 300;
                text-transform: uppercase;
                letter-spacing: 0.3em;
                color: var(--text-muted);
                margin-top: 2mm;
            }

            h2 {
                font-size: 9pt;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: 0.4em;
                color: var(--text-muted);
                border-bottom: 2px solid var(--text-main);
                padding-bottom: 2mm;
                margin-bottom: 4mm;
                display: flex;
                align-items: center;
                gap: 3mm;
            }

            h3 {
                font-size: 11pt;
                font-weight: 700;
                margin: 0;
                letter-spacing: -0.02em;
            }

            .contact-item {
                display: flex;
                align-items: center;
                gap: 3mm;
                font-size: 8pt;
                font-weight: 500;
                color: var(--text-muted);
            }

            .section-title-dot {
                width: 2mm;
                height: 2mm;
                background: var(--text-main);
            }

            .skill-tag {
                font-size: 7.5pt;
                font-weight: 600;
                padding: 1mm 2mm;
                border: 1px solid var(--border-color);
                background: white;
                white-space: nowrap;
            }

            .exp-item {
                position: relative;
                padding-left: 6mm;
                border-left: 1px solid var(--border-color);
            }

            .exp-dot {
                position: absolute;
                left: -1.5mm;
                top: 2mm;
                width: 3mm;
                height: 3mm;
                background: white;
                border: 1px solid var(--text-main);
            }

            .exp-meta {
                font-size: 8pt;
                font-weight: 700;
                color: #64748b;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                margin-bottom: 1mm;
            }

            .exp-company {
                font-size: 9pt;
                font-weight: 600;
                font-style: italic;
                color: #475569;
                margin-bottom: 3mm;
            }

            .exp-desc {
                font-size: 9pt;
                line-height: 1.5;
                color: #334155;
            }

            .exp-desc p { margin-bottom: 2mm; }

            .exp-skills {
                display: flex;
                flex-wrap: wrap;
                gap: 1.5mm;
                margin-top: 3mm;
            }

            .exp-skill {
                font-size: 7pt;
                font-weight: 800;
                text-transform: uppercase;
                padding: 0.5mm 1.5mm;
                border: 1px solid #cbd5e1;
                color: #64748b;
            }

            @media print {
                body {
                    background: white;
                }
                .no-print-header {
                    display: none !important;
                }
                .a4-container {
                    margin: 0;
                    box-shadow: none;
                    width: 210mm;
                    height: 297mm;
                }
            }

            .profile-img-container {
                width: 55mm;
                height: 55mm;
                border: 1px solid var(--border-color);
                overflow: hidden;
                filter: grayscale(1);
            }

            .profile-img-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        </style>
    </head>
    <body>
        <header class="no-print-header">
            <a href="/" class="btn">
                <ArrowLeft size={14} />
                Retour
            </a>
            <div style="font-size: 0.7rem; font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase;">A4 Preview</div>
            <button onclick="window.print()" class="btn">
                <Printer size={14} />
                Imprimer en PDF
            </button>
        </header>

        <div class="a4-container">
            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="profile-img-container">
                    <img src="/Damien-miri.webp" alt={name} />
                </div>

                <div class="space-y-4">
                    <div class="contact-item">
                        <Mail size={12} />
                        {email}
                    </div>
                    <div class="contact-item">
                        <MapPin size={12} />
                        {location}
                    </div>
                    {websites.map(site => (
                        <div class="contact-item">
                            <Globe size={12} />
                            {site.name}
                        </div>
                    ))}
                </div>

                <section>
                    <h2>Outils & Expertise</h2>
                    <div style="display: flex; flex-direction: column; gap: 4mm;">
                        {softwareGroups.map(group => (
                            <div>
                                <div style="font-size: 7.5pt; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); margin-bottom: 2mm;">
                                    {group.category}
                                </div>
                                <div style="display: flex; flex-wrap: wrap; gap: 1.5mm;">
                                    {group.tools.map(tool => (
                                        <span class="skill-tag">{tool}</span>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Certification</h2>
                    <div style="font-size: 8pt; font-weight: 800; text-transform: uppercase; margin-bottom: 1mm;">{certification.title}</div>
                    <div style="font-size: 8pt; font-weight: 700; color: var(--text-main); margin-bottom: 1mm;">{certification.role}</div>
                    <div style="font-size: 8pt; color: var(--text-muted); line-height: 1.4;">{certification.desc}</div>
                </section>
                
                <section>
                    <h2>Transmission</h2>
                    <div style="display: flex; flex-direction: column; gap: 3.5mm;">
                        {teaching.map(item => (
                            <div>
                                <div style="font-size: 7.5pt; font-weight: 800; text-transform: uppercase; line-height: 1.2;">{item.company}</div>
                                <div style="font-size: 7.5pt; font-weight: 600; color: var(--text-main);">{item.title}</div>
                                <div style="font-size: 7pt; color: var(--text-muted); line-height: 1.3;">{item.period} — {item.desc}</div>
                            </div>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Soft Skills</h2>
                    <div style="display: flex; flex-wrap: wrap; gap: 2mm;">
                        {softSkills.map(skill => (
                            <span class="skill-tag" style="text-transform: uppercase; letter-spacing: 0.05em;">{skill}</span>
                        ))}
                    </div>
                </section>

                <section>
                    <h2>Philosophie</h2>
                    <div style="display: flex; flex-direction: column; gap: 4mm;">
                        {philosophies.map(phi => (
                            <div>
                                <div style="font-size: 8pt; font-weight: 800; text-transform: uppercase; margin-bottom: 1mm;">{phi.title}</div>
                                {phi.detail && <div style="font-size: 8pt; font-style: italic; color: var(--text-muted); margin-bottom: 0.5mm;">{phi.detail}</div>}
                                <div style="font-size: 8pt; color: var(--text-muted); line-height: 1.4;">{phi.desc}</div>
                            </div>
                        ))}
                    </div>
                </section>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                <header>
                    <h1>{name}</h1>
                    <div class="subtitle">{title}</div>
                    {tagline && <div style="font-size: 7pt; color: #94a3b8; margin-top: 1.5mm; font-style: italic; letter-spacing: 0.05em; font-weight: 500;">{tagline}</div>}
                </header>

                <section>
                    <h2>Parcours Professionnel</h2>
                    <div style="display: flex; flex-direction: column; gap: 8mm;">
                        {experiences.map(exp => (
                            <div class="exp-item">
                                <div class="exp-dot"></div>
                                <div class="exp-meta">{exp.period}</div>
                                <h3>{exp.title}</h3>
                                <div class="exp-company">{exp.company} — {exp.location}</div>
                                <div class="exp-desc">
                                    {exp.desc.split('\n\n').map(p => (
                                        <p>{p}</p>
                                    ))}
                                </div>
                                {exp.skills && (
                                    <div class="exp-skills">
                                        {exp.skills.map(skill => (
                                            <span class="exp-skill">{skill}</span>
                                        ))}
                                    </div>
                                )}
                            </div>
                        ))}
                    </div>
                </section>
            </main>
        </div>
    </body>
</html>
